# Neon connection string — from your Neon project dashboard
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string — used to sign auth JWTs
JWT_SECRET="change-me-to-a-long-random-string"

# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Free tier — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"

PORT=4000

# Frontend origin, for CORS
CORS_ORIGIN="http://localhost:5173"

# Frontend origin used to build password-reset links. Falls back to CORS_ORIGIN.
FRONTEND_URL="http://localhost:5173"

# Sends password-reset emails over HTTPS (not SMTP — many hosts, including
# Render's free tier, block outbound SMTP ports). Get a free key at
# https://resend.com/api-keys — no domain verification needed to start.
RESEND_API_KEY=""

# Optional: only set this once you've verified your own domain in Resend.
# Until then, emails send from onboarding@resend.dev, which works with no
# setup.
RESEND_FROM=""

# Who gets notified when someone submits "Request access". Defaults to
# support@heliosqe.com if unset.
# ACCESS_REQUEST_NOTIFY_EMAIL="support@heliosqe.com"

# Autonomous Testing — off by default. This feature launches a real browser,
# logs into a target application with user-supplied credentials, and
# autonomously explores/tests it. See server/src/autonomous/.
ENABLE_AUTONOMOUS_TESTING="false"

# Optional safety-limit overrides — sane defaults are used if unset.
# AUTONOMOUS_MAX_PAGES=25
# AUTONOMOUS_MAX_ACTIONS=150
# AUTONOMOUS_MAX_AI_ITERATIONS=100
# AUTONOMOUS_MAX_TESTS=15
# AUTONOMOUS_MAX_RUN_DURATION_MS=1200000

# API Studio Environments — required only if you save a Sensitive/Secret
# classified environment variable (e.g. an API key). A 32-byte key, base64
# encoded. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes existing encrypted variables undecryptable — there
# is no re-encryption tool yet, so treat it like any other long-lived secret.
# API_STUDIO_SECRET_ENCRYPTION_KEY=""
