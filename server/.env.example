# Neon connection string — from your Neon project dashboard
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string — used to sign auth JWTs
JWT_SECRET="change-me-to-a-long-random-string"

# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Free tier — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"

PORT=4000

# Frontend origin, for CORS
CORS_ORIGIN="http://localhost:5173"

# Frontend origin used to build password-reset links. Falls back to CORS_ORIGIN.
FRONTEND_URL="http://localhost:5173"

# SMTP settings for sending password-reset emails.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
