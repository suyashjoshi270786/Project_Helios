generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("Test Architect")
  avatarUrl    String?
  createdAt    DateTime @default(now())

  requirements   Requirement[]
  projects       Project[]
  testPlans      TestPlan[]
  approvedPlans  TestPlan[] @relation("TestPlanApprover")
  folders        Folder[]
  testSuites     TestSuite[]
  testCases      TestCase[]
  passwordResetTokens PasswordResetToken[]
  testCycles     TestCycle[]
  defects        Defect[]
  workItems      WorkItem[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requirements Requirement[]
  testPlans    TestPlan[]
  folders      Folder[]
  testSuites   TestSuite[]
  testCases    TestCase[]
  testCycles   TestCycle[]
  defects      Defect[]
  workItems    WorkItem[]

  @@index([createdById])
}

enum RequirementStatus {
  Draft
  InReview
  Approved
}

enum RequirementPriority {
  Low
  Medium
  High
}

model Requirement {
  id                 String              @id @default(cuid())
  title              String
  description        String
  acceptanceCriteria String[]
  flows              String[]
  risks              String[]
  status             RequirementStatus   @default(Draft)
  priority           RequirementPriority @default(Medium)
  sourceText         String?
  projectId          String
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById        String
  createdBy          User                @relation(fields: [createdById], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  testPlanLinks TestPlanRequirement[]

  @@index([createdById])
  @@index([projectId])
}

enum TestPlanStatus {
  DRAFT
  UNDER_REVIEW
  GENERATING
  GENERATED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum TestPlanPriority {
  Critical
  High
  Medium
  Low
}

model TestPlan {
  id     String @id @default(cuid())
  planCode String
  version  String @default("1.0")
  previousVersionId String?
  isLatest Boolean @default(true)

  name             String
  status           TestPlanStatus    @default(DRAFT)
  testPhase        String
  releaseVersion   String
  environment      String
  priority         TestPlanPriority  @default(Medium)
  owner            String
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  objective        String

  testTypes      String[]
  otherTestType  String?

  inScope    String[]
  outOfScope String[]

  testStrategy      Json?
  testDataStrategy  Json?
  environmentConfig Json?
  entryCriteria     Json?
  exitCriteria      Json?
  risks             Json?
  dependencies      Json?
  resources         Json?
  schedule          Json?

  aiProvider        String   @default("gemini")
  documentFormats   String[] @default([])
  generatedContent  Json?
  generatedAt       DateTime?
  approvedById      String?
  approvedBy        User?    @relation("TestPlanApprover", fields: [approvedById], references: [id])
  approvedAt        DateTime?
  rejectedReason    String?

  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  links TestPlanRequirement[]

  @@unique([projectId, planCode, version])
  @@index([projectId])
  @@index([createdById])
  @@index([approvedById])
}

model TestPlanRequirement {
  id            String      @id @default(cuid())
  testPlanId    String
  testPlan      TestPlan    @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([testPlanId, requirementId])
  @@index([requirementId])
}

model Folder {
  id          String   @id @default(cuid())
  name        String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[] @relation("FolderChildren")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testSuites TestSuite[]

  @@index([projectId])
  @@index([parentId])
}

model TestSuite {
  id          String   @id @default(cuid())
  name        String
  folderId    String
  folder      Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testCases TestCase[]

  @@index([folderId])
  @@index([projectId])
}

enum TestCaseType {
  Manual
  Automated
}

model TestCase {
  id            String       @id @default(cuid())
  code          String
  name          String
  objective     String?
  preconditions String?
  environment   String?
  testPhase     String?
  testType      TestCaseType @default(Manual)
  archived      Boolean      @default(false)

  testSuiteId String
  testSuite   TestSuite @relation(fields: [testSuiteId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  steps          TestStep[]
  cycleTests     TestCycleTest[]
  workItemLinks  WorkItemTestCase[]

  @@unique([projectId, code])
  @@index([testSuiteId])
  @@index([projectId])
}

model TestStep {
  id             String   @id @default(cuid())
  testCaseId     String
  testCase       TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  stepNumber     Int
  description    String
  testData       String?
  expectedResult String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([testCaseId])
}

enum TestCycleStatus {
  NotStarted
  InProgress
  Completed
}

enum ExecutionStatus {
  NotExecuted
  Pass
  Fail
  Blocked
}

model TestCycle {
  id          String          @id @default(cuid())
  name        String
  testPhase   String
  environment String?
  description String?
  startDate   DateTime?
  endDate     DateTime?
  owner       String?
  status      TestCycleStatus @default(NotStarted)

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tests TestCycleTest[]

  @@index([projectId])
  @@index([createdById])
}

model TestCycleTest {
  id          String    @id @default(cuid())
  testCycleId String
  testCycle   TestCycle @relation(fields: [testCycleId], references: [id], onDelete: Cascade)
  testCaseId  String
  testCase    TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  environment String?
  tester      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  execution TestExecution?

  @@unique([testCycleId, testCaseId])
  @@index([testCaseId])
}

model TestExecution {
  id              String          @id @default(cuid())
  testCycleTestId String          @unique
  testCycleTest   TestCycleTest   @relation(fields: [testCycleTestId], references: [id], onDelete: Cascade)
  status          ExecutionStatus @default(NotExecuted)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  steps TestStepExecution[]
}

model TestStepExecution {
  id              String          @id @default(cuid())
  testExecutionId String
  testExecution   TestExecution   @relation(fields: [testExecutionId], references: [id], onDelete: Cascade)
  testStepId      String?
  stepNumber      Int
  description     String
  testData        String?
  expectedResult  String
  status          ExecutionStatus @default(NotExecuted)
  actualResult    String?
  comment         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  defectLinks TestStepExecutionDefect[]

  @@index([testExecutionId])
}

enum DefectStatus {
  Open
  Closed
}

model Defect {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      DefectStatus @default(Open)

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stepLinks TestStepExecutionDefect[]

  @@index([projectId])
}

model TestStepExecutionDefect {
  id                  String            @id @default(cuid())
  testStepExecutionId String
  testStepExecution   TestStepExecution @relation(fields: [testStepExecutionId], references: [id], onDelete: Cascade)
  defectId            String
  defect              Defect            @relation(fields: [defectId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@unique([testStepExecutionId, defectId])
}

// Agile Work Management — a single polymorphic entity for every level of the
// hierarchy (Initiative/Epic/Feature/Story/Task/Sub-Task, and later Defect),
// per the "do not create Work Item as another hierarchy level, do not create
// a separate table per type" guidance. Status/priority are free-text (not
// enums) so workflows stay configurable per type instead of hardcoded.
enum WorkItemType {
  Initiative
  Epic
  Feature
  Story
  Task
  SubTask
  Defect
}

model WorkItem {
  id      String       @id @default(cuid())
  type    WorkItemType
  key     String
  title   String
  description String?

  // Structured user-story narrative — only meaningful for type = Story.
  asA    String?
  iWant  String?
  soThat String?

  status   String  @default("Backlog")
  priority String?
  assignee String?
  reporter String?

  storyPoints       Int?
  originalEstimate  Float?
  remainingEstimate Float?

  labels     String[]
  components String[]

  startDate  DateTime?
  targetDate DateTime?
  dueDate    DateTime?

  parentId String?
  parent   WorkItem?  @relation("WorkItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children WorkItem[] @relation("WorkItemChildren")

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  acceptanceCriteria WorkItemAcceptanceCriterion[]
  testCaseLinks      WorkItemTestCase[]

  @@unique([projectId, key])
  @@index([projectId])
  @@index([parentId])
  @@index([createdById])
}

model WorkItemAcceptanceCriterion {
  id         String   @id @default(cuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  text       String
  completed  Boolean  @default(false)
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([workItemId])
}

model WorkItemTestCase {
  id         String   @id @default(cuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([workItemId, testCaseId])
  @@index([testCaseId])
}
