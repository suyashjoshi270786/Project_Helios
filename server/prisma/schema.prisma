generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  role               String   @default("Test Architect")
  avatarUrl          String?
  // Set when an admin hands this account a password directly (new-account
  // provisioning, or an admin-triggered reset) rather than the user picking
  // their own — forces the change-password wizard on next login.
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())

  requirements        Requirement[]
  projects            Project[]
  testPlans           TestPlan[]
  approvedPlans       TestPlan[]           @relation("TestPlanApprover")
  folders             Folder[]
  testSuites          TestSuite[]
  testCases           TestCase[]
  passwordResetTokens PasswordResetToken[]
  testCycles          TestCycle[]
  workItems           WorkItem[]
  sprints             Sprint[]
  apiTokens           ApiToken[]

  teamMemberships TeamMember[]
  createdTeams    Team[]       @relation("TeamCreator")
  sentInvites     TeamInvite[] @relation("InviteSender")
  assignedItems   WorkItem[]   @relation("WorkItemAssignee")
  reportedItems   WorkItem[]   @relation("WorkItemReporter")

  reviewedAccessRequests AccessRequest[]  @relation("AccessRequestReviewer")
  autonomousRuns         AutonomousRun[]
  createdApiRequests     ApiRequest[]   @relation("ApiRequestCreatedBy")
  updatedApiRequests     ApiRequest[]   @relation("ApiRequestUpdatedBy")
  apiExecutions          ApiExecution[]
  apiFolders             ApiFolder[]
  apiEnvironments        ApiEnvironment[]
  apiWorkflows           ApiWorkflow[]
  apiWorkflowRuns        ApiWorkflowRun[]
}

enum AccessRequestStatus {
  Pending
  Approved
  Denied
}

// Self-registration is disabled — a new person requests access here, and an
// Owner/Admin reviews it in-app and provisions the account (see
// routes/accessRequests.ts) rather than anyone being able to sign themselves up.
model AccessRequest {
  id           String              @id @default(cuid())
  name         String
  email        String
  phone        String?
  reason       String?
  status       AccessRequestStatus @default(Pending)
  createdAt    DateTime            @default(now())
  reviewedById String?
  reviewedBy   User?               @relation("AccessRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  @@index([email])
  @@index([status])
}

enum TeamRole {
  Owner
  Admin
  Member
}

// A Team owns Projects and holds the roster of people who can see them — the
// multi-user foundation the app didn't have before (everything used to be
// scoped to a single createdById). One user can belong to several Teams.
model Team {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdBy   User     @relation("TeamCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  TeamMember[]
  invites  TeamInvite[]
  projects Project[]

  @@index([createdById])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TeamRole @default(Member)
  joinedAt DateTime @default(now())

  // Which modules this member can use, e.g. ["requirements", "test-cases"].
  // Only checked for role = Member — Owners and Admins always have full
  // access since they're the ones granting it.
  modules String[] @default([])

  @@unique([teamId, userId])
  @@index([userId])
}

enum TeamInviteStatus {
  Pending
  Accepted
  Revoked
}

// Superseded — adding someone to a team is now immediate (POST
// /teams/:id/invites creates/adds the account directly, see routes/teams.ts)
// rather than a pending link+accept flow. Left in place only so any
// historical rows aren't orphaned; nothing creates new ones.
model TeamInvite {
  id          String           @id @default(cuid())
  teamId      String
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email       String
  role        TeamRole         @default(Member)
  modules     String[]         @default([])
  status      TeamInviteStatus @default(Pending)
  tokenHash   String           @unique
  invitedById String
  invitedBy   User             @relation("InviteSender", fields: [invitedById], references: [id])
  createdAt   DateTime         @default(now())
  expiresAt   DateTime

  @@index([teamId])
  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A long-lived credential for automation frameworks (CI runners, custom
// scripts) to call the API without a browser session. Inherits the creating
// user's own team roles/module permissions at request time — see
// middleware/auth.ts. Same raw-token/hash pattern as PasswordResetToken.
model ApiToken {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Attribution only — who created it. Access control runs through teamId,
  // not this field, so any team member can see and act on the project.
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requirements Requirement[]
  testPlans    TestPlan[]
  folders      Folder[]
  testSuites   TestSuite[]
  testCases    TestCase[]
  testCycles   TestCycle[]
  workItems    WorkItem[]
  sprints      Sprint[]
  autonomousRuns AutonomousRun[]
  apiRequests    ApiRequest[]
  apiFolders     ApiFolder[]
  apiExecutions  ApiExecution[]
  apiEnvironments ApiEnvironment[]
  apiWorkflows    ApiWorkflow[]
  apiWorkflowRuns ApiWorkflowRun[]

  @@index([createdById])
  @@index([teamId])
}

enum RequirementStatus {
  Draft
  InReview
  Approved
}

enum RequirementPriority {
  Low
  Medium
  High
}

model Requirement {
  id                 String              @id @default(cuid())
  title              String
  description        String
  acceptanceCriteria String[]
  flows              String[]
  risks              String[]
  status             RequirementStatus   @default(Draft)
  priority           RequirementPriority @default(Medium)
  sourceText         String?
  projectId          String
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById        String
  createdBy          User                @relation(fields: [createdById], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  testPlanLinks      TestPlanRequirement[]
  generatedTestCases TestCase[]

  @@index([createdById])
  @@index([projectId])
}

enum TestPlanStatus {
  DRAFT
  UNDER_REVIEW
  GENERATING
  GENERATED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum TestPlanPriority {
  Critical
  High
  Medium
  Low
}

model TestPlan {
  id                String  @id @default(cuid())
  planCode          String
  version           String  @default("1.0")
  previousVersionId String?
  isLatest          Boolean @default(true)

  name             String
  status           TestPlanStatus   @default(DRAFT)
  testPhase        String
  releaseVersion   String
  environment      String
  priority         TestPlanPriority @default(Medium)
  owner            String
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  objective        String

  testTypes     String[]
  otherTestType String?

  inScope    String[]
  outOfScope String[]

  testStrategy      Json?
  testDataStrategy  Json?
  environmentConfig Json?
  entryCriteria     Json?
  exitCriteria      Json?
  risks             Json?
  dependencies      Json?
  resources         Json?
  schedule          Json?

  aiProvider       String    @default("gemini")
  documentFormats  String[]  @default([])
  generatedContent Json?
  generatedAt      DateTime?
  approvedById     String?
  approvedBy       User?     @relation("TestPlanApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  rejectedReason   String?

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  links TestPlanRequirement[]

  @@unique([projectId, planCode, version])
  @@index([projectId])
  @@index([createdById])
  @@index([approvedById])
}

model TestPlanRequirement {
  id            String      @id @default(cuid())
  testPlanId    String
  testPlan      TestPlan    @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([testPlanId, requirementId])
  @@index([requirementId])
}

model Folder {
  id          String   @id @default(cuid())
  name        String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[] @relation("FolderChildren")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testSuites TestSuite[]

  @@index([projectId])
  @@index([parentId])
}

model TestSuite {
  id          String   @id @default(cuid())
  name        String
  folderId    String
  folder      Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testCases TestCase[]

  @@index([folderId])
  @@index([projectId])
}

enum TestCaseType {
  Manual
  Automated
}

model TestCase {
  id            String       @id @default(cuid())
  code          String
  name          String
  objective     String?
  preconditions String?
  environment   String?
  testPhase     String?
  testType      TestCaseType @default(Manual)
  archived      Boolean      @default(false)

  // Cucumber-style script, used instead of `steps` when testType = Automated.
  gherkinScript String?

  // Set when this test case was AI-generated from an approved Requirement —
  // lets a later "Generate Test Cases" run on the same requirement detect and
  // reuse the suite it already created instead of duplicating it.
  sourceRequirementId String?
  sourceRequirement   Requirement? @relation(fields: [sourceRequirementId], references: [id], onDelete: SetNull)

  // Set when this test case was generated by an Autonomous Testing run
  // instead of a human/manual "Generate Test Cases" pass.
  autonomousRunId String?
  autonomousRun   AutonomousRun? @relation("AutonomousRunTestCases", fields: [autonomousRunId], references: [id], onDelete: SetNull)

  testSuiteId String
  testSuite   TestSuite @relation(fields: [testSuiteId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  steps         TestStep[]
  cycleTests    TestCycleTest[]
  workItemLinks WorkItemTestCase[]

  @@unique([projectId, code])
  @@index([testSuiteId])
  @@index([projectId])
  @@index([sourceRequirementId])
  @@index([autonomousRunId])
}

model TestStep {
  id             String   @id @default(cuid())
  testCaseId     String
  testCase       TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  stepNumber     Int
  description    String
  testData       String?
  expectedResult String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([testCaseId])
}

enum TestCycleStatus {
  NotStarted
  InProgress
  Completed
}

enum ExecutionStatus {
  NotExecuted
  Pass
  Fail
  Blocked
}

model TestCycle {
  id          String          @id @default(cuid())
  code        String
  name        String
  testPhase   String
  environment String?
  description String?
  startDate   DateTime?
  endDate     DateTime?
  owner       String?
  status      TestCycleStatus @default(NotStarted)

  // Set when this cycle was created by an Autonomous Testing run instead of
  // a human "Create Test Cycle" action.
  autonomousRunId String?
  autonomousRun   AutonomousRun? @relation("AutonomousRunTestCycles", fields: [autonomousRunId], references: [id], onDelete: SetNull)

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tests TestCycleTest[]

  @@unique([projectId, code])
  @@index([projectId])
  @@index([createdById])
  @@index([autonomousRunId])
}

model TestCycleTest {
  id          String    @id @default(cuid())
  testCycleId String
  testCycle   TestCycle @relation(fields: [testCycleId], references: [id], onDelete: Cascade)
  testCaseId  String
  testCase    TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  environment String?
  tester      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  execution TestExecution?

  @@unique([testCycleId, testCaseId])
  @@index([testCaseId])
}

model TestExecution {
  id              String          @id @default(cuid())
  testCycleTestId String          @unique
  testCycleTest   TestCycleTest   @relation(fields: [testCycleTestId], references: [id], onDelete: Cascade)
  status          ExecutionStatus @default(NotExecuted)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  steps TestStepExecution[]
}

model TestStepExecution {
  id              String          @id @default(cuid())
  testExecutionId String
  testExecution   TestExecution   @relation(fields: [testExecutionId], references: [id], onDelete: Cascade)
  testStepId      String?
  stepNumber      Int
  description     String
  testData        String?
  expectedResult  String
  status          ExecutionStatus @default(NotExecuted)
  actualResult    String?
  comment         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  defectLinks WorkItemStepLink[]

  @@index([testExecutionId])
}

// Agile Work Management — a single polymorphic entity for every level of the
// hierarchy (Initiative/Epic/Feature/Story/Task/Sub-Task, and later Defect),
// per the "do not create Work Item as another hierarchy level, do not create
// a separate table per type" guidance. Status/priority are free-text (not
// enums) so workflows stay configurable per type instead of hardcoded.
enum WorkItemType {
  Initiative
  Epic
  Feature
  Story
  Task
  SubTask
  Defect
}

model WorkItem {
  id          String       @id @default(cuid())
  type        WorkItemType
  key         String
  title       String
  description String?

  // Structured user-story narrative — only meaningful for type = Story.
  asA    String?
  iWant  String?
  soThat String?

  status   String  @default("Backlog")
  priority String?

  // Legacy free-text fields from before real team membership existed — kept
  // only so old records still display something. New assignments go through
  // assigneeId/reporterId, a real link to a team member.
  assignee String?
  reporter String?

  assigneeId String?
  assignedTo User?   @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId String?
  reportedBy User?   @relation("WorkItemReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  // Defect-only fields — nullable and only meaningful for type = Defect, same
  // "single polymorphic entity" pattern as asA/iWant/soThat above for Story.
  severity         String?
  environment      String?
  stepsToReproduce String?
  expectedResult   String?
  actualResult     String?

  storyPoints       Int?
  originalEstimate  Float?
  remainingEstimate Float?

  labels     String[]
  components String[]

  startDate  DateTime?
  targetDate DateTime?
  dueDate    DateTime?

  // Backlog ordering — a float so an item can be dropped between two
  // neighbors (new rank = midpoint) without renumbering the whole list.
  rank Float @default(0)

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  parentId String?
  parent   WorkItem?  @relation("WorkItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children WorkItem[] @relation("WorkItemChildren")

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  acceptanceCriteria WorkItemAcceptanceCriterion[]
  testCaseLinks      WorkItemTestCase[]
  stepLinks          WorkItemStepLink[]

  @@unique([projectId, key])
  @@index([projectId])
  @@index([parentId])
  @@index([createdById])
  @@index([sprintId])
  @@index([assigneeId])
  @@index([reporterId])
}

enum SprintStatus {
  Planned
  Active
  Completed
}

model Sprint {
  id     String       @id @default(cuid())
  name   String
  goal   String?
  status SprintStatus @default(Planned)

  startDate DateTime?
  endDate   DateTime?

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workItems WorkItem[]

  @@index([projectId])
}

// Links a Defect-type WorkItem to the specific failed test step it was raised
// from (or attached to after the fact via "Link Existing Defect"). Replaces
// the old dedicated Defect/TestStepExecutionDefect tables now that Defect is
// a WorkItem type rather than a separate concept (per the spec's explicit
// "do not duplicate Defect" guidance).
model WorkItemStepLink {
  id                  String            @id @default(cuid())
  workItemId          String
  workItem            WorkItem          @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  testStepExecutionId String
  testStepExecution   TestStepExecution @relation(fields: [testStepExecutionId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@unique([workItemId, testStepExecutionId])
  @@index([testStepExecutionId])
}

model WorkItemAcceptanceCriterion {
  id         String   @id @default(cuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  text       String
  completed  Boolean  @default(false)
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([workItemId])
}

model WorkItemTestCase {
  id         String   @id @default(cuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([workItemId, testCaseId])
  @@index([testCaseId])
}

enum AutonomousRunStatus {
  Pending
  Running
  Completed
  Failed
  Cancelled
}

enum AutonomousStageName {
  Initialization
  Login
  AuthVerification
  Exploration
  WorkflowDiscovery
  ScenarioGeneration
  BddGeneration
  TestGeneration
  TestCycleCreation
  TestExecution
  FailureAnalysis
  DefectCreation
  ReportGeneration
}

enum AutonomousStageStatus {
  Pending
  Running
  Completed
  Failed
  Skipped
  Cancelled
}

// One row per "Start Run" invocation of the Autonomous Testing feature.
// Deliberately has NO username/password columns — credentials are received
// once by the route, handed to the browser controller in memory, and never
// persisted anywhere (see server/src/autonomous/orchestrator.ts). Discovery/
// workflow/scenario/BDD/report artifacts are compact JSON columns rather
// than fully normalized child tables, since each is produced once and
// consumed together by the report.
model AutonomousRun {
  id           String                @id @default(cuid())
  targetUrl    String
  appName      String?
  environment  String?
  instructions String?
  maxDepth     Int?
  maxTests     Int?
  status       AutonomousRunStatus   @default(Pending)
  currentStage AutonomousStageName?

  discoveredPages    Json?
  discoveredElements Json?
  workflows          Json?
  scenarios          Json?
  bddDocuments       Json?
  report             Json?

  pagesVisited   Int @default(0)
  actionsTaken   Int @default(0)
  testsGenerated Int @default(0)
  testsExecuted  Int @default(0)
  testsPassed    Int @default(0)
  testsFailed    Int @default(0)
  defectsCreated Int @default(0)

  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages     AutonomousStage[]
  testCases  TestCase[]  @relation("AutonomousRunTestCases")
  testCycles TestCycle[] @relation("AutonomousRunTestCycles")

  @@index([projectId])
  @@index([createdById])
  @@index([status])
}

// Live per-stage status/progress/logs for the run-progress polling UI. One
// row per AutonomousStageName is created (as Pending) when a run starts.
model AutonomousStage {
  id              String                @id @default(cuid())
  autonomousRunId String
  autonomousRun   AutonomousRun         @relation(fields: [autonomousRunId], references: [id], onDelete: Cascade)
  stage           AutonomousStageName
  status          AutonomousStageStatus @default(Pending)
  progress        Int                   @default(0)
  logs            Json?
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([autonomousRunId, stage])
  @@index([autonomousRunId])
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  HEAD
  OPTIONS
}

enum ApiAuthType {
  None
  Bearer
  Basic
  ApiKey
}

enum ApiExecutionStatus {
  Success // request sent, a response was received (any HTTP status code)
  Error // network/DNS/timeout/size-cap failure before a response arrived
  Blocked // rejected by SSRF policy before any connection was attempted
}

// The aggregate verdict once a request has assertions attached — distinct
// from ApiExecutionStatus, which only reflects the transport outcome. A
// request that gets a clean 200 but fails an assertion is `status: Success`
// (the HTTP call worked) yet `overallResult: Fail` (the test didn't pass).
// Only present when the request actually had assertions — see
// computeOverallResult in server/src/apiStudio/assertions.ts.
enum ApiTestResult {
  Pass
  Fail
  Error
  Blocked
  Skipped
}

enum VariableClassification {
  Public
  Configuration
  Sensitive
  Secret
}

// A tier label for future production safeguards (explicit confirmation,
// elevated permission, restricted methods, stronger audit) — none of those
// are enforced yet, only stored, per the spec's "can later enforce" framing.
enum EnvironmentClassification {
  Development
  Staging
  Production
}

// One Environment per DEV/SIT/UAT/PROD-style target a project's requests can
// run against. Lets the same saved ApiRequest run against different
// baseUrl/credentials by switching which environment is selected at Send
// time, rather than editing the request.
model ApiEnvironment {
  id             String                     @id @default(cuid())
  name           String
  description    String?
  classification EnvironmentClassification  @default(Development)
  projectId      String
  project        Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User                       @relation(fields: [createdById], references: [id])
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  variables  ApiEnvironmentVariable[]
  executions ApiExecution[]

  @@index([projectId])
}

// A real child table, not a compact Json array like ApiRequest.queryParams/
// headers — unlike those, each variable needs its own encryption/
// classification handling, which doesn't fit the "produced and consumed
// together" Json-blob rationale used elsewhere in this schema.
model ApiEnvironmentVariable {
  id             String                  @id @default(cuid())
  environmentId  String
  environment    ApiEnvironment          @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  key            String
  classification VariableClassification  @default(Configuration)
  // Plaintext — only populated for Public/Configuration.
  value          String?
  // AES-256-GCM ciphertext (iv+authTag+data, base64-joined) — only populated
  // for Sensitive/Secret. Never returned by any GET response — see
  // server/src/routes/apiStudio.ts and server/src/apiStudio/secretCrypto.ts.
  encryptedValue String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([environmentId, key])
  @@index([environmentId])
}

enum WorkflowFailurePolicy {
  Stop
  Continue
  ContinueButMarkFailed
}

// An explicit, ordered, multi-step scenario chaining EXISTING ApiRequest
// rows (by id — a step can reference a request from anywhere in the
// project, not just one folder), extracting values from each response into
// execution-scoped variables the next step can use. Distinct from ApiFolder/
// "Run Collection" (still exists, unchanged) — that runs "whatever's in this
// folder" with no data passing; a Workflow is a deliberate recipe.
model ApiWorkflow {
  id            String                @id @default(cuid())
  name          String
  description   String?
  failurePolicy WorkflowFailurePolicy @default(Stop)
  // [{ id, order, apiRequestId, extractions: [{ source: "jsonPath"|"header", path, variableName }] }]
  // Json array, not a child table — always read/edited as one ordered
  // whole, same rationale as ApiRequest.assertions/headers/queryParams.
  steps         Json?
  projectId     String
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User                  @relation(fields: [createdById], references: [id])
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  runs ApiWorkflowRun[]

  @@index([projectId])
}

// One row per "Run Workflow". Each step's actual HTTP call still creates a
// real ApiExecution row (so it shows up in that request's own history,
// reusing the whole existing executor/assertion/masking pipeline) — this
// row's `steps` Json just traces the run as one unit:
// [{ stepId, apiRequestId, apiExecutionId, extractedVariables, status }].
model ApiWorkflowRun {
  id            String        @id @default(cuid())
  workflowId    String
  workflow      ApiWorkflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  correlationId String
  overallResult ApiTestResult // reuses the Stage 03 enum — same aggregate-verdict shape
  steps         Json
  executedById  String
  executedBy    User          @relation(fields: [executedById], references: [id])
  startedAt     DateTime      @default(now())
  completedAt   DateTime      @default(now())

  @@index([workflowId])
  @@index([projectId])
}

// How an execution was triggered. Everything today is Manual (a human
// clicked Send, including via "Run Collection", which is still a human
// action even though it fires several requests at once) — Test/Cycle are
// Stage 06's Helios Test Cycle integration, Scheduled/CI are Stage 07's
// automation stage. The enum exists now so those stages add a value rather
// than a schema concept.
enum ApiExecutionMode {
  Manual
  Test
  Cycle
  Scheduled
  CI
}

// One saved API Studio request definition, scoped to a Project like every
// other QE artifact. Stores only what's needed to build and fire a request
// today — assertions/API Tests, environment variable resolution,
// collections/folders/chaining, and encrypted secret storage are later
// stages. authConfig/headers may hold literal secret-looking values (e.g. a
// pasted Bearer token) but are NOT encrypted here — that matches how
// TestPlan.environmentConfig stores plain Json today. Reversible encryption
// only becomes necessary once {{variable}}-scoped secrets need to persist
// independently of one request (a later Environments stage), so it isn't
// built here.
model ApiRequest {
  id          String     @id @default(cuid())
  name        String
  description String?
  method      HttpMethod @default(GET)
  // May contain {{variable}} placeholders; sent literally for now since
  // there is no Environment/variable resolution yet.
  url         String

  // Json arrays of {key, value, enabled} — compact JSON like AutonomousRun's
  // discovery fields, rather than normalized child tables, since each is
  // produced and consumed together.
  queryParams Json?
  headers     Json?

  // Free string ("none" | "json" | "text" | "form" ...), not an enum, so
  // later body types can be added without a migration.
  bodyType String?
  body     String?

  authType   ApiAuthType @default(None)
  // Shape keyed by authType: { token } for Bearer, { username, password }
  // for Basic, { key, value, in } for ApiKey.
  authConfig Json?

  // Clamped server-side to the executor's own [min,max] ceiling regardless
  // of what's stored here — see server/src/apiStudio/constants.ts.
  timeoutMs Int @default(15000)

  // Stored per the domain spec, but not yet wired to real behavior — the
  // executor unconditionally never follows a redirect (server/src/apiStudio/net/safeFetch.ts),
  // matching the security guardrail "disable redirects by default; if
  // redirects are later enabled, validate every hop." No UI exposes this as
  // a working toggle yet, since a toggle that doesn't change behavior would
  // be dishonest — it's here so a later stage that DOES implement safe
  // per-hop-validated redirects has a column to read instead of a migration.
  followRedirects Boolean @default(false)

  // {key, value, enabled} pairs for {name}-style tokens found in the URL —
  // same compact-JSON choice as queryParams/headers above.
  pathParams Json?
  // Assertion definitions: [{ id, name, type, target, operator, expected }].
  // Lives on the request rather than a separate "API Test" entity — see
  // server/src/apiStudio/assertions.ts for the evaluator.
  assertions Json?

  folderId String?
  // Cascade, not SetNull — the DELETE /folders/:id route explicitly counts
  // and confirms ("this folder isn't empty") before deleting with
  // cascade=true, matching Folder->TestSuite's real delete-with-contents
  // semantics. SetNull would silently leave requests behind as "ungrouped"
  // instead of actually deleting them, contradicting that confirmation.
  folder ApiFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation("ApiRequestCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("ApiRequestUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions ApiExecution[]

  @@index([projectId])
  @@index([createdById])
  @@index([updatedById])
  @@index([folderId])
}

// Collections tree for API Studio — same self-referential parent/children
// shape as the existing Folder model (server/src/routes/folders.ts), kept as
// its own table rather than reusing Folder since Folder's children are
// hardcoded to TestSuite, not ApiRequest.
model ApiFolder {
  id          String      @id @default(cuid())
  name        String
  description String?
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      ApiFolder?  @relation("ApiFolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    ApiFolder[] @relation("ApiFolderChildren")
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  requests ApiRequest[]

  @@index([projectId])
  @@index([parentId])
}

// Immutable execution log — one row per "Send". Snapshots what was actually
// sent so editing/deleting the parent ApiRequest later doesn't change
// history. Response is size-capped before persistence (see the executor).
model ApiExecution {
  id           String     @id @default(cuid())
  apiRequestId String
  apiRequest   ApiRequest @relation(fields: [apiRequestId], references: [id], onDelete: Cascade)
  // Denormalized from apiRequest.projectId so execution history can be
  // queried/scoped by project directly, without a join — same reasoning as
  // AutonomousStage keeping its own fields rather than always joining up
  // to AutonomousRun.
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // How this execution was triggered — see ApiExecutionMode.
  executionMode ApiExecutionMode @default(Manual)
  // Ties together every execution fired by one triggering action — a single
  // Send gets its own correlationId; every execution in one "Run Collection"
  // batch shares one, so they can be queried/displayed as a set later.
  correlationId String

  // Set when this row is a "Rerun" — re-evaluating a past response snapshot
  // against the request's current assertions without resending the HTTP
  // request. Points at the execution whose response was reused. Null for a
  // normal Send.
  retestOfId String?
  retestOf   ApiExecution?  @relation("ApiExecutionRetest", fields: [retestOfId], references: [id], onDelete: SetNull)
  retests    ApiExecution[] @relation("ApiExecutionRetest")

  // Which Environment (if any) supplied {{variable}} values for this
  // execution — lets history show/filter which target this ran against.
  environmentId String?
  environment   ApiEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  method         HttpMethod
  url            String // fully resolved URL actually connected to
  requestHeaders Json? // redacted: Authorization/secret values masked before storage
  requestBody    String?

  status            ApiExecutionStatus
  statusCode        Int?
  responseHeaders   Json?
  responseBody      String?
  responseTruncated Boolean @default(false)
  responseSizeBytes Int?

  durationMs   Int?
  // Short machine-readable code (e.g. "SSRF_BLOCKED", "TIMEOUT",
  // "DNS_ERROR", "INVALID_URL") alongside the human-readable errorMessage —
  // lets the UI/future automation branch on failure kind without parsing text.
  errorCode    String?
  errorMessage String? // safe/generic only, never raw internals

  // One entry per assertion evaluated at execution time: { id, name, type,
  // expected, actual, status: "PASS"|"FAIL"|"SKIPPED"|"ERROR", message,
  // evidence }. `evidence` points at what was checked (e.g.
  // "responseHeaders.content-type", "responseBody $.data.id") so a failure
  // can be traced back without re-deriving it. Persisted so a past
  // execution's Test Results never change retroactively even if the
  // request's assertions are edited later.
  assertionResults Json?
  // null when the request had no assertions (a plain request execution, not
  // a "test") — see ApiTestResult.
  overallResult ApiTestResult?

  executedById String
  executedBy   User     @relation(fields: [executedById], references: [id])
  // The pipeline is fully synchronous today (no queue), so these are set
  // immediately before/after the executor call — kept as two fields rather
  // than one timestamp so a later async/queued execution model (Scheduled/CI)
  // doesn't need a migration to add "when did it actually start running."
  startedAt   DateTime @default(now())
  completedAt DateTime @default(now())

  @@index([apiRequestId])
  @@index([executedById])
  @@index([projectId])
  @@index([correlationId])
  @@index([retestOfId])
  @@index([environmentId])
}
