generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("Test Architect")
  avatarUrl    String?
  createdAt    DateTime @default(now())

  requirements        Requirement[]
  projects            Project[]
  testPlans           TestPlan[]
  approvedPlans       TestPlan[]           @relation("TestPlanApprover")
  folders             Folder[]
  testSuites          TestSuite[]
  testCases           TestCase[]
  passwordResetTokens PasswordResetToken[]
  testCycles          TestCycle[]
  workItems           WorkItem[]
  sprints             Sprint[]
  apiTokens           ApiToken[]

  teamMemberships TeamMember[]
  createdTeams    Team[]       @relation("TeamCreator")
  sentInvites     TeamInvite[] @relation("InviteSender")
  assignedItems   WorkItem[]   @relation("WorkItemAssignee")
  reportedItems   WorkItem[]   @relation("WorkItemReporter")

  reviewedAccessRequests AccessRequest[] @relation("AccessRequestReviewer")
}

enum AccessRequestStatus {
  Pending
  Approved
  Denied
}

// Self-registration is disabled — a new person requests access here, and an
// Owner/Admin reviews it in-app and provisions the account (see
// routes/accessRequests.ts) rather than anyone being able to sign themselves up.
model AccessRequest {
  id           String              @id @default(cuid())
  name         String
  email        String
  reason       String?
  status       AccessRequestStatus @default(Pending)
  createdAt    DateTime            @default(now())
  reviewedById String?
  reviewedBy   User?               @relation("AccessRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  @@index([email])
  @@index([status])
}

enum TeamRole {
  Owner
  Admin
  Member
}

// A Team owns Projects and holds the roster of people who can see them — the
// multi-user foundation the app didn't have before (everything used to be
// scoped to a single createdById). One user can belong to several Teams.
model Team {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdBy   User     @relation("TeamCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  TeamMember[]
  invites  TeamInvite[]
  projects Project[]

  @@index([createdById])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TeamRole @default(Member)
  joinedAt DateTime @default(now())

  // Which modules this member can use, e.g. ["requirements", "test-cases"].
  // Only checked for role = Member — Owners and Admins always have full
  // access since they're the ones granting it.
  modules String[] @default([])

  @@unique([teamId, userId])
  @@index([userId])
}

enum TeamInviteStatus {
  Pending
  Accepted
  Revoked
}

// Invite-by-email: if the email already has an account, accepting just adds
// a TeamMember; otherwise the token carries the invite through registration.
model TeamInvite {
  id          String           @id @default(cuid())
  teamId      String
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email       String
  role        TeamRole         @default(Member)
  modules     String[]         @default([])
  status      TeamInviteStatus @default(Pending)
  tokenHash   String           @unique
  invitedById String
  invitedBy   User             @relation("InviteSender", fields: [invitedById], references: [id])
  createdAt   DateTime         @default(now())
  expiresAt   DateTime

  @@index([teamId])
  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A long-lived credential for automation frameworks (CI runners, custom
// scripts) to call the API without a browser session. Inherits the creating
// user's own team roles/module permissions at request time — see
// middleware/auth.ts. Same raw-token/hash pattern as PasswordResetToken.
model ApiToken {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Attribution only — who created it. Access control runs through teamId,
  // not this field, so any team member can see and act on the project.
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requirements Requirement[]
  testPlans    TestPlan[]
  folders      Folder[]
  testSuites   TestSuite[]
  testCases    TestCase[]
  testCycles   TestCycle[]
  workItems    WorkItem[]
  sprints      Sprint[]

  @@index([createdById])
  @@index([teamId])
}

enum RequirementStatus {
  Draft
  InReview
  Approved
}

enum RequirementPriority {
  Low
  Medium
  High
}

model Requirement {
  id                 String              @id @default(cuid())
  title              String
  description        String
  acceptanceCriteria String[]
  flows              String[]
  risks              String[]
  status             RequirementStatus   @default(Draft)
  priority           RequirementPriority @default(Medium)
  sourceText         String?
  projectId          String
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById        String
  createdBy          User                @relation(fields: [createdById], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  testPlanLinks      TestPlanRequirement[]
  generatedTestCases TestCase[]

  @@index([createdById])
  @@index([projectId])
}

enum TestPlanStatus {
  DRAFT
  UNDER_REVIEW
  GENERATING
  GENERATED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum TestPlanPriority {
  Critical
  High
  Medium
  Low
}

model TestPlan {
  id                String  @id @default(cuid())
  planCode          String
  version           String  @default("1.0")
  previousVersionId String?
  isLatest          Boolean @default(true)

  name             String
  status           TestPlanStatus   @default(DRAFT)
  testPhase        String
  releaseVersion   String
  environment      String
  priority         TestPlanPriority @default(Medium)
  owner            String
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  objective        String

  testTypes     String[]
  otherTestType String?

  inScope    String[]
  outOfScope String[]

  testStrategy      Json?
  testDataStrategy  Json?
  environmentConfig Json?
  entryCriteria     Json?
  exitCriteria      Json?
  risks             Json?
  dependencies      Json?
  resources         Json?
  schedule          Json?

  aiProvider       String    @default("gemini")
  documentFormats  String[]  @default([])
  generatedContent Json?
  generatedAt      DateTime?
  approvedById     String?
  approvedBy       User?     @relation("TestPlanApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  rejectedReason   String?

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  links TestPlanRequirement[]

  @@unique([projectId, planCode, version])
  @@index([projectId])
  @@index([createdById])
  @@index([approvedById])
}

model TestPlanRequirement {
  id            String      @id @default(cuid())
  testPlanId    String
  testPlan      TestPlan    @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([testPlanId, requirementId])
  @@index([requirementId])
}

model Folder {
  id          String   @id @default(cuid())
  name        String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[] @relation("FolderChildren")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testSuites TestSuite[]

  @@index([projectId])
  @@index([parentId])
}

model TestSuite {
  id          String   @id @default(cuid())
  name        String
  folderId    String
  folder      Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testCases TestCase[]

  @@index([folderId])
  @@index([projectId])
}

enum TestCaseType {
  Manual
  Automated
}

model TestCase {
  id            String       @id @default(cuid())
  code          String
  name          String
  objective     String?
  preconditions String?
  environment   String?
  testPhase     String?
  testType      TestCaseType @default(Manual)
  archived      Boolean      @default(false)

  // Cucumber-style script, used instead of `steps` when testType = Automated.
  gherkinScript String?

  // Set when this test case was AI-generated from an approved Requirement —
  // lets a later "Generate Test Cases" run on the same requirement detect and
  // reuse the suite it already created instead of duplicating it.
  sourceRequirementId String?
  sourceRequirement   Requirement? @relation(fields: [sourceRequirementId], references: [id], onDelete: SetNull)

  testSuiteId String
  testSuite   TestSuite @relation(fields: [testSuiteId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  steps         TestStep[]
  cycleTests    TestCycleTest[]
  workItemLinks WorkItemTestCase[]

  @@unique([projectId, code])
  @@index([testSuiteId])
  @@index([projectId])
  @@index([sourceRequirementId])
}

model TestStep {
  id             String   @id @default(cuid())
  testCaseId     String
  testCase       TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  stepNumber     Int
  description    String
  testData       String?
  expectedResult String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([testCaseId])
}

enum TestCycleStatus {
  NotStarted
  InProgress
  Completed
}

enum ExecutionStatus {
  NotExecuted
  Pass
  Fail
  Blocked
}

model TestCycle {
  id          String          @id @default(cuid())
  code        String
  name        String
  testPhase   String
  environment String?
  description String?
  startDate   DateTime?
  endDate     DateTime?
  owner       String?
  status      TestCycleStatus @default(NotStarted)

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tests TestCycleTest[]

  @@unique([projectId, code])
  @@index([projectId])
  @@index([createdById])
}

model TestCycleTest {
  id          String    @id @default(cuid())
  testCycleId String
  testCycle   TestCycle @relation(fields: [testCycleId], references: [id], onDelete: Cascade)
  testCaseId  String
  testCase    TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  environment String?
  tester      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  execution TestExecution?

  @@unique([testCycleId, testCaseId])
  @@index([testCaseId])
}

model TestExecution {
  id              String          @id @default(cuid())
  testCycleTestId String          @unique
  testCycleTest   TestCycleTest   @relation(fields: [testCycleTestId], references: [id], onDelete: Cascade)
  status          ExecutionStatus @default(NotExecuted)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  steps TestStepExecution[]
}

model TestStepExecution {
  id              String          @id @default(cuid())
  testExecutionId String
  testExecution   TestExecution   @relation(fields: [testExecutionId], references: [id], onDelete: Cascade)
  testStepId      String?
  stepNumber      Int
  description     String
  testData        String?
  expectedResult  String
  status          ExecutionStatus @default(NotExecuted)
  actualResult    String?
  comment         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  defectLinks WorkItemStepLink[]

  @@index([testExecutionId])
}

// Agile Work Management — a single polymorphic entity for every level of the
// hierarchy (Initiative/Epic/Feature/Story/Task/Sub-Task, and later Defect),
// per the "do not create Work Item as another hierarchy level, do not create
// a separate table per type" guidance. Status/priority are free-text (not
// enums) so workflows stay configurable per type instead of hardcoded.
enum WorkItemType {
  Initiative
  Epic
  Feature
  Story
  Task
  SubTask
  Defect
}

model WorkItem {
  id          String       @id @default(cuid())
  type        WorkItemType
  key         String
  title       String
  description String?

  // Structured user-story narrative — only meaningful for type = Story.
  asA    String?
  iWant  String?
  soThat String?

  status   String  @default("Backlog")
  priority String?

  // Legacy free-text fields from before real team membership existed — kept
  // only so old records still display something. New assignments go through
  // assigneeId/reporterId, a real link to a team member.
  assignee String?
  reporter String?

  assigneeId String?
  assignedTo User?   @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId String?
  reportedBy User?   @relation("WorkItemReporter", fields: [reporterId], references: [id], onDelete: SetNull)

  // Defect-only fields — nullable and only meaningful for type = Defect, same
  // "single polymorphic entity" pattern as asA/iWant/soThat above for Story.
  severity         String?
  environment      String?
  stepsToReproduce String?
  expectedResult   String?
  actualResult     String?

  storyPoints       Int?
  originalEstimate  Float?
  remainingEstimate Float?

  labels     String[]
  components String[]

  startDate  DateTime?
  targetDate DateTime?
  dueDate    DateTime?

  // Backlog ordering — a float so an item can be dropped between two
  // neighbors (new rank = midpoint) without renumbering the whole list.
  rank Float @default(0)

  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  parentId String?
  parent   WorkItem?  @relation("WorkItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children WorkItem[] @relation("WorkItemChildren")

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  acceptanceCriteria WorkItemAcceptanceCriterion[]
  testCaseLinks      WorkItemTestCase[]
  stepLinks          WorkItemStepLink[]

  @@unique([projectId, key])
  @@index([projectId])
  @@index([parentId])
  @@index([createdById])
  @@index([sprintId])
  @@index([assigneeId])
  @@index([reporterId])
}

enum SprintStatus {
  Planned
  Active
  Completed
}

model Sprint {
  id     String       @id @default(cuid())
  name   String
  goal   String?
  status SprintStatus @default(Planned)

  startDate DateTime?
  endDate   DateTime?

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workItems WorkItem[]

  @@index([projectId])
}

// Links a Defect-type WorkItem to the specific failed test step it was raised
// from (or attached to after the fact via "Link Existing Defect"). Replaces
// the old dedicated Defect/TestStepExecutionDefect tables now that Defect is
// a WorkItem type rather than a separate concept (per the spec's explicit
// "do not duplicate Defect" guidance).
model WorkItemStepLink {
  id                  String            @id @default(cuid())
  workItemId          String
  workItem            WorkItem          @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  testStepExecutionId String
  testStepExecution   TestStepExecution @relation(fields: [testStepExecutionId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())

  @@unique([workItemId, testStepExecutionId])
  @@index([testStepExecutionId])
}

model WorkItemAcceptanceCriterion {
  id         String   @id @default(cuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  text       String
  completed  Boolean  @default(false)
  order      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([workItemId])
}

model WorkItemTestCase {
  id         String   @id @default(cuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([workItemId, testCaseId])
  @@index([testCaseId])
}
